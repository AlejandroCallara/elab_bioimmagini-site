e(\"Image B\",fontsize=12)\naxs1.set_axis_off()","key":"VjzVabokCu"},{"type":"outputs","id":"1jK3iAv4C__qpJGcgtPmL","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"6ea403a78d19e726f9c5384f0bdaedf7","path":"/elab_bioimmagini-site/build/6ea403a78d19e726f9c5384f0bdaedf7.png"},"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"i7mq4T3YfE"}],"key":"B2IDMhNqbA"}],"key":"Ifwho339p4"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Applichiamo il metodo RGB creando uan immagine a tre canali dalle due immagini da fondere","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oVmE04NtqM"}],"key":"A4ZqckpxRp"}],"key":"icMv7v93Tu"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-27T15:55:00.572195Z","iopub.status.busy":"2026-01-27T15:55:00.571704Z","iopub.status.idle":"2026-01-27T15:55:00.591412Z","shell.execute_reply":"2026-01-27T15:55:00.590484Z","shell.execute_reply.started":"2026-01-27T15:55:00.572162Z"},"trusted":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# RGB method\nA3 = np.stack([A, np.zeros([A.shape[0],A.shape[1]]), A], axis = -1)  # pink\nB3 = np.stack([np.zeros([B.shape[0],B.shape[1]]), B, np.zeros([B.shape[0],B.shape[1]])], axis = -1)  # green\nRGB = np.stack([A, B, A], axis = -1)  # create fused image","key":"mP8mJ5iBLF"},{"type":"outputs","id":"3nJd_NBTBEXWjjVhz103P","children":[],"key":"NJQ5dbcrUe"}],"key":"bPbvWn8BK4"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-27T15:56:48.506816Z","iopub.status.busy":"2026-01-27T15:56:48.506456Z","iopub.status.idle":"2026-01-27T15:56:48.791569Z","shell.execute_reply":"2026-01-27T15:56:48.790639Z","shell.execute_reply.started":"2026-01-27T15:56:48.506787Z"},"trusted":true},"children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(10,4)) \naxs0 = fig.add_subplot(1, 3, 1)\naxs1 = fig.add_subplot(1, 3, 2)\naxs2 = fig.add_subplot(1, 3, 3)\nimgplot = axs0.imshow(A3)\naxs0.set_title(\"Image A\",fontsize=12)\naxs0.set_axis_off()\nimgplot = axs1.imshow(B3)\naxs1.set_title(\"Image B\",fontsize=12)\naxs1.set_axis_off()\nimgplot = axs2.imshow(RGB)\naxs2.set_title(\"Image RGB\",fontsize=12)\naxs2.set_axis_off()","key":"i7ZQhHvmcG"},{"type":"outputs","id":"0wBgfdcYcB1Dwl8bBVFNJ","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b3f5254cec7665017a225b7736324fb2","path":"/elab_bioimmagini-site/build/b3f5254cec7665017a225b7736324fb2.png"},"text/plain":{"content":"<Figure size 1000x400 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"n8WGgujhie"}],"key":"plfwGWznL3"}],"key":"GCKeLpB5Ms"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Vediamo il risultato dell’image fusion","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tSZDF0GTsj"}],"key":"NKwskRSsty"}],"key":"d8F4urWjE4"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Realizziamo il blending con le librerie opencv","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ob9TJ2ncn6"}],"key":"cFAe7kptZT"}],"key":"WdJ64XvEFW"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-27T15:57:42.883784Z","iopub.status.busy":"2026-01-27T15:57:42.883186Z","iopub.status.idle":"2026-01-27T15:57:43.272623Z","shell.execute_reply":"2026-01-27T15:57:43.271759Z","shell.execute_reply.started":"2026-01-27T15:57:42.883745Z"},"trusted":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# blending method\nalfa=0.5\nBlend = cv2.addWeighted(A, alfa, B, 1-alfa, 0) \nfig = plt.figure(figsize=(10,4)) \naxs0 = fig.add_subplot(1, 3, 1)\naxs1 = fig.add_subplot(1, 3, 2)\naxs2 = fig.add_subplot(1, 3, 3)\nimgplot = axs0.imshow(A,cmap='gray')\naxs0.set_title(\"Image A\",fontsize=12)\naxs0.set_axis_off()\nimgplot = axs1.imshow(B,cmap='gray')\naxs1.set_title(\"Image B\",fontsize=12)\naxs1.set_axis_off()\nimgplot = axs2.imshow(Blend,cmap='gray')\naxs2.set_title(\"Image Blend\",fontsize=12)\naxs2.set_axis_off()","key":"sk6JNAUiKf"},{"type":"outputs","id":"-ol-jiQw2B_ymLOWtRJGY","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4ee240b996952dacac4d7e86e8252b75","path":"/elab_bioimmagini-site/build/4ee240b996952dacac4d7e86e8252b75.png"},"text/plain":{"content":"<Figure size 1000x400 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"kGZ3JuKuVf"}],"key":"EBuR1nuhgT"}],"key":"ejxIVt4Fzj"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-27T15:59:02.076893Z","iopub.status.busy":"2026-01-27T15:59:02.076541Z","iopub.status.idle":"2026-01-27T15:59:14.023926Z","shell.execute_reply":"2026-01-27T15:59:14.023100Z","shell.execute_reply.started":"2026-01-27T15:59:02.076862Z"},"trusted":true},"children":[{"type":"code","lang":"python","executable":true,"value":"fig, ax = plt.subplots(1,11)\nalfaValues=np.linspace(0,1,11)\nfor i in range(11):\n    Blend = cv2.addWeighted(A, alfaValues[i], B, 1-alfaValues[i], 0) \n    imgplot = ax[i].imshow(Blend,cmap='gray')\n    input(\"Press Enter to continue...\")","key":"bltacAgGl5"},{"type":"outputs","id":"2XLEcd7NCYspP1uWwhOcE","children":[],"key":"ifQezxA2al"}],"key":"bFM9frweds"}],"key":"IdUEkuVPVJ"},"references":{"cite":{"or