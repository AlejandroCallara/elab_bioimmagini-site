 B\",fontsize=12)\naxs1.set_axis_off()","key":"v9N9R9s9wf"},{"type":"outputs","id":"sZQOk7gI4UZy_ixs_0VMp","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"6ea403a78d19e726f9c5384f0bdaedf7","path":"/myst_assets_folder/6ea403a78d19e726f9c5384f0bdaedf7.png"},"text/plain":{"content":"<Figure size 1000x400 with 2 Axes>","content_type":"text/plain"}}},"children":[],"key":"H2Mu00HOfA"}],"key":"ZzbAyjCJjT"}],"key":"vi2X5XuaQT"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Applichiamo il metodo RGB creando uan immagine a tre canali dalle due immagini da fondere","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"COWOd4oMos"}],"key":"YDH3fW7y7h"}],"key":"luXmWT5x2o"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-27T15:55:00.572195Z","iopub.status.busy":"2026-01-27T15:55:00.571704Z","iopub.status.idle":"2026-01-27T15:55:00.591412Z","shell.execute_reply":"2026-01-27T15:55:00.590484Z","shell.execute_reply.started":"2026-01-27T15:55:00.572162Z"},"trusted":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# RGB method\nA3 = np.stack([A, np.zeros([A.shape[0],A.shape[1]]), A], axis = -1)  # pink\nB3 = np.stack([np.zeros([B.shape[0],B.shape[1]]), B, np.zeros([B.shape[0],B.shape[1]])], axis = -1)  # green\nRGB = np.stack([A, B, A], axis = -1)  # create fused image","key":"NBp2U56ykg"},{"type":"outputs","id":"3smi8hgnkpgPqbPE3dDwC","children":[],"key":"NhbdrYSZAp"}],"key":"EEsttsf2EY"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-27T15:56:48.506816Z","iopub.status.busy":"2026-01-27T15:56:48.506456Z","iopub.status.idle":"2026-01-27T15:56:48.791569Z","shell.execute_reply":"2026-01-27T15:56:48.790639Z","shell.execute_reply.started":"2026-01-27T15:56:48.506787Z"},"trusted":true},"children":[{"type":"code","lang":"python","executable":true,"value":"fig = plt.figure(figsize=(10,4)) \naxs0 = fig.add_subplot(1, 3, 1)\naxs1 = fig.add_subplot(1, 3, 2)\naxs2 = fig.add_subplot(1, 3, 3)\nimgplot = axs0.imshow(A3)\naxs0.set_title(\"Image A\",fontsize=12)\naxs0.set_axis_off()\nimgplot = axs1.imshow(B3)\naxs1.set_title(\"Image B\",fontsize=12)\naxs1.set_axis_off()\nimgplot = axs2.imshow(RGB)\naxs2.set_title(\"Image RGB\",fontsize=12)\naxs2.set_axis_off()","key":"MiJy3YPPHf"},{"type":"outputs","id":"IRdnGn8sNYye3Y0Ym_Rqj","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b3f5254cec7665017a225b7736324fb2","path":"/myst_assets_folder/b3f5254cec7665017a225b7736324fb2.png"},"text/plain":{"content":"<Figure size 1000x400 with 3 Axes>","content_type":"text/plain"}}},"children":[],"key":"wfDtQT9mrV"}],"key":"ZEVD7Z2UeF"}],"key":"iyhCYhnzpN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Vediamo il risultato dell’image fusion","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"e3pGuFd9L9"}],"key":"YQfIUqLYwh"}],"key":"aOJqF3Lroi"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Realizziamo il blending con le librerie opencv","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kcYZnD2AJY"}],"key":"Plz1FY002w"}],"key":"G8cebgWqV7"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-27T15:57:42.883784Z","iopub.status.busy":"2026-01-27T15:57:42.883186Z","iopub.status.idle":"2026-01-27T15:57:43.272623Z","shell.execute_reply":"2026-01-27T15:57:43.271759Z","shell