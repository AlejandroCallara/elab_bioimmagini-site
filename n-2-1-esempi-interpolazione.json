:"interpolazione-tramite-interpn","implicit":true,"key":"fPxTVykvKN"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Esempio di interpolazione tramite l’utilizzo della funzione ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"PLmygv3WpH"},{"type":"inlineCode","value":"interpn","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"SPqlduK1RZ"},{"type":"text","value":" e visualizzazione 3D tramite la libreria ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"u4ePOLA6pc"},{"type":"strong","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"napari","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rHwKujw8hX"}],"key":"UItsZvt8jo"},{"type":"text","value":".","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"o3STo4TFAA"}],"key":"q6dGVumhdD"}],"key":"Jang0w2Ao4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# original coordinates\nx = np.arange(0,xSize*dx,dx)\ny = np.arange(0,ySize*dy,dy)\nz = np.arange(0,zSize*dz,dz)\n\n# new coordinates\nnew_x = np.arange(0,xSize*dx,dx)\nnew_y = np.arange(0,ySize*dy,dy)\nnew_z = np.arange(0,(zSize-1)*dz,dx)\n\n# mesh of new coordinates\nnew_coords = np.meshgrid(new_z,new_x, new_y, indexing = 'ij');\nvolumeInt = interpn((z,x,y), vol, np.stack(new_coords,axis=-1))\n\n# check new size\nprint(\"dimensioni dopo interpolazione:\", volumeInt.shape)\n\n# use napari\nviewer = napari.view_image(volumeInt, name = \"my volume interpolated\", colormap = \"gray\")\n\n# run the viewer\nnapari.run()","key":"l23JMDg9hV"},{"type":"outputs","id":"h1AxMYKg-t9ZmYAZBsh9s","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"dimensioni dopo interpolazione: (227, 512, 512)\n"},"children":[],"key":"K9zEgB3rVI"},{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/var/folders/f2/szdn4h555wv3xkj5npgb1nqc0000gn/T/ipykernel_3149/298611104.py:19: FutureWarning: `napari.view_image` is deprecated and will be removed in napari 0.7.0.\nUse `viewer = napari.Viewer(); viewer.add_image(...)` instead.\n  viewer = napari.view_image(volumeInt, name = \"my volume interpolated\", colormap = \"gray\")\n"},"children":[],"key":"YdrqcU2Lha"}],"key":"XVL9Id1IBQ"}],"key":"ex1TvQ6vGZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Interpolazione tramite ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k3pGL3IhJz"},{"type":"inlineCode","value":"zoom","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MnmOWVq380"}],"identifier":"interpolazione-tramite-zoom","label":"Interpolazione tramite zoom","html_id":"interpolazione-tramite-zoom","implicit":true,"key":"Yf9E5zsd8F"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Interpolazione nel piano tramite l’utilizzo della funzione ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"kUGiOGxpT8"},{"type":"inlineCode","value":"zoom","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"DnP8Ng8uz9"}],"key":"JXdApJXHR5"}],"key":"Xf6JQS3pIS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# plane interpolation\nimg = vol[33,:,:]\n\n# original image\nfig, ax = plt.subplots()\nax.imshow(img, cmap = \"gray\")\nax.set_title(\"Original\")\nplt.show()\n\n# set scaling factor\nscaling_factors = (2, 2)","key":"biFkSZdwdL"},{"type":"outputs","id":"WlSnvRZLeX6Eg2NFFu61k","children":[{"type":"output","jupyter_data":{"output_type":"displ