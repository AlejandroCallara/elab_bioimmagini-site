],"key":"fQ7QHLXgKU"},{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"/var/folders/f2/szdn4h555wv3xkj5npgb1nqc0000gn/T/ipykernel_3149/298611104.py:19: FutureWarning: `napari.view_image` is deprecated and will be removed in napari 0.7.0.\nUse `viewer = napari.Viewer(); viewer.add_image(...)` instead.\n  viewer = napari.view_image(volumeInt, name = \"my volume interpolated\", colormap = \"gray\")\n"},"children":[],"key":"xp5wFuWzcA"}],"key":"CGMBHdqu7J"}],"key":"JNrtbBFAZE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Interpolazione tramite ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"s9kXF98PaM"},{"type":"inlineCode","value":"zoom","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q7yh5vjgJH"}],"identifier":"interpolazione-tramite-zoom","label":"Interpolazione tramite zoom","html_id":"interpolazione-tramite-zoom","implicit":true,"key":"pxSWCNoEgq"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Interpolazione nel piano tramite l’utilizzo della funzione ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rUoMxqS6xR"},{"type":"inlineCode","value":"zoom","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"bkGSTJdOW1"}],"key":"pynOQkK8DA"}],"key":"uBUAymZmgJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# plane interpolation\nimg = vol[33,:,:]\n\n# original image\nfig, ax = plt.subplots()\nax.imshow(img, cmap = \"gray\")\nax.set_title(\"Original\")\nplt.show()\n\n# set scaling factor\nscaling_factors = (2, 2)","key":"qrIe0ZG7jf"},{"type":"outputs","id":"vdClAAjOeSt3Jp79gWjaN","children":[{"type":"output","jupyter_data":{"output_type":"displ