":"python","executable":true,"value":"overlap_id = np.array(np.where((A ==1)&(B==1)))\noverlap=len(overlap_id[0])\nprint('Overlap area = ',overlap,' (number of pixels)')","key":"TSwZC67kdr"},{"type":"outputs","id":"LMBlJQzt7uzgoo5_7Wo5r","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Overlap area =  11664  (number of pixels)\n"},"children":[],"key":"ecOBdSkc71"}],"key":"zZkRWvQzyb"}],"key":"X8WI7JbHbW"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calcoliamo l’indice di Jaccard","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bcOV0bQFJh"}],"key":"i2DRw81uvX"}],"key":"uSFLexsPx2"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-22T15:21:33.382947Z","iopub.status.busy":"2026-01-22T15:21:33.382601Z","iopub.status.idle":"2026-01-22T15:21:33.390016Z","shell.execute_reply":"2026-01-22T15:21:33.389177Z","shell.execute_reply.started":"2026-01-22T15:21:33.382919Z"},"trusted":true},"children":[{"type":"code","lang":"python","executable":true,"value":"AB_mask_id = np.array(np.where((A ==1) | (B==1)))\nAB_mask_size=len(AB_mask_id[0])\nJaccard_index = overlap/AB_mask_size\nprint('Jaccard index = ',Jaccard_index,' (number of pixels)')","key":"J0aITfRazG"},{"type":"outputs","id":"30Bi7lRqQrFs0EjhT7ypZ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Jaccard index =  0.5526914329037149  (number of pixels)\n"},"children":[],"key":"RMWJIw31Qj"}],"key":"sdpPUiISrT"}],"key":"tm27LRFoyP"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calcoliamo l’indice di Jaccard attraverso la libreria sklearn","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":