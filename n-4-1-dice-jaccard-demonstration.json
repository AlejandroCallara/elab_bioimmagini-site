able":true,"value":"overlap_id = np.array(np.where((A ==1)&(B==1)))\noverlap=len(overlap_id[0])\nprint('Overlap area = ',overlap,' (number of pixels)')","key":"ATTmaIAPFM"},{"type":"outputs","id":"udx9SSH3qj-B6MJgbuPIL","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Overlap area =  11664  (number of pixels)\n"},"children":[],"key":"fR3kr06fL8"}],"key":"yycsp2GFAx"}],"key":"LEbi3v7nD0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calcoliamo l’indice di Jaccard","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ku52w6yQ7F"}],"key":"VtfXbWaAPA"}],"key":"d69xtEMy5c"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-22T15:21:33.382947Z","iopub.status.busy":"2026-01-22T15:21:33.382601Z","iopub.status.idle":"2026-01-22T15:21:33.390016Z","shell.execute_reply":"2026-01-22T15:21:33.389177Z","shell.execute_reply.started":"2026-01-22T15:21:33.382919Z"},"trusted":true},"children":[{"type":"code","lang":"python","executable":true,"value":"AB_mask_id = np.array(np.where((A ==1) | (B==1)))\nAB_mask_size=len(AB_mask_id[0])\nJaccard_index = overlap/AB_mask_size\nprint('Jaccard index = ',Jaccard_index,' (number of pixels)')","key":"GyJnqOkI89"},{"type":"outputs","id":"dLPasTNrW_OGn6HBPdUpC","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Jaccard index =  0.5526914329037149  (number of pixels)\n"},"children":[],"key":"EPtvnCIVJ7"}],"key":"VU3mugZFQ0"}],"key":"lm9ZRNPcoR"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calcoliamo l’indice di Jaccard attraverso la libreria sklearn","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hPLMCA5