ry) = ',Dice_lib1,Dice_lib2,' (number of pixels)')\n","key":"VR13CBrSa6"},{"type":"outputs","id":"4VQUZgpbWQT4JR0JfJ-cU","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Dice index =  0.7119140625  (number of pixels)\nDice index (library) =  0.7119140625 0.7119140625  (number of pixels)\n"},"children":[],"key":"U4h4N1fAkE"}],"key":"cn5fmhUdxq"}],"key":"HKMLQRNxnS"}],"key":"fWInsBwGAg"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Capitolo 4: Validazione degli Algoritmi di Analisi dell’Immagine Biomedica","url":"/c14-imm-biom","group":"Capitolo4"},"next":{"title":"Capitolo 5: Registrazione e Fusione di Immagini","url":"/c15-imm-biom","group":"Capitolo5"}}},"domain":"http://localhost:3000"}