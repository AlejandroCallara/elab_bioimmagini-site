":"python","executable":true,"value":"overlap_id = np.array(np.where((A ==1)&(B==1)))\noverlap=len(overlap_id[0])\nprint('Overlap area = ',overlap,' (number of pixels)')","key":"lo0xw8GkPu"},{"type":"outputs","id":"8q3r1k_irIAiIU7lCYPma","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Overlap area =  11664  (number of pixels)\n"},"children":[],"key":"i70H3JC44O"}],"key":"itnhJsC3AW"}],"key":"gb9df2ILCE"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calcoliamo l’indice di Jaccard","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VsAlqAseci"}],"key":"GM8ruIAdtf"}],"key":"LZOwTv8VS1"},{"type":"block","kind":"notebook-code","data":{"execution":{"iopub.execute_input":"2026-01-22T15:21:33.382947Z","iopub.status.busy":"2026-01-22T15:21:33.382601Z","iopub.status.idle":"2026-01-22T15:21:33.390016Z","shell.execute_reply":"2026-01-22T15:21:33.389177Z","shell.execute_reply.started":"2026-01-22T15:21:33.382919Z"},"trusted":true},"children":[{"type":"code","lang":"python","executable":true,"value":"AB_mask_id = np.array(np.where((A ==1) | (B==1)))\nAB_mask_size=len(AB_mask_id[0])\nJaccard_index = overlap/AB_mask_size\nprint('Jaccard index = ',Jaccard_index,' (number of pixels)')","key":"glS2HIu9BG"},{"type":"outputs","id":"iGSusL2bY7b2gxF9ZMl-k","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Jaccard index =  0.5526914329037149  (number of pixels)\n"},"children":[],"key":"nStaXmldGL"}],"key":"BPAg9OsgzM"}],"key":"oB40hGJSRr"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Calcoliamo l’indice di Jaccard attraverso la libreria sklearn","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":